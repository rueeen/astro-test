---
import { Image } from "astro:assets";
import aboutImage from "../assets/about.png";
import SectionHeading from "./SectionHeading.astro";

interface Props {
  title: string;
  subtitle: string;
  text: string;
  mission: string;
  vision: string;
}

const { title, subtitle, text, mission, vision } = Astro.props;
---

<section id="nosotros" class="relative overflow-hidden bg-surface py-20">
  <div
    class="relative z-10 mx-auto grid max-w-7xl gap-10 px-5 lg:grid-cols-2 lg:px-8"
  >
    <div class="space-y-6">
      <SectionHeading eyebrow="Nosotros" title={title} lead={subtitle} />
      <div class="space-y-6" data-reveal>
        <p class="text-primary/80">{text}</p>

        <div class="relative w-full overflow-hidden rounded-2xl shadow-lg">
          <Image
            src={aboutImage}
            alt="Operación industrial"
            class="h-auto w-full object-cover object-center"
            quality="high"
          />
        </div>
      </div>
    </div>

    <div class="grid gap-6" data-reveal>
      <article
        class="rounded-2xl bg-white p-7 shadow-sm ring-1 ring-primary/15"
      >
        <h3 class="text-xl font-bold text-primary">Misión</h3>
        <p class="mt-3 text-primary/80">{mission}</p>
      </article>

      <article
        class="relative overflow-hidden rounded-2xl bg-primary p-7 text-slate-100 shadow-sm"
      >
        <h3 class="relative z-10 text-xl font-bold text-accent">Visión</h3>
        <p class="relative z-10 mt-3 text-slate-100/95">{vision}</p>
      </article>
    </div>
  </div>
</section>
