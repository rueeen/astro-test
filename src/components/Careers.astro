---
interface Step {
  title: string;
  text: string;
}

interface Props {
  eyebrow: string;
  title: string;
  subtitle: string;
  text: string;
  steps: Step[];
  formHref: string;
  buttonLabel: string;
}

const { eyebrow, title, subtitle, text, steps, formHref, buttonLabel } = Astro.props;
---

<section id="postulantes" class="relative overflow-hidden bg-white py-20">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <div class="grid gap-12 lg:grid-cols-[1fr_1.1fr] lg:items-center">
      <div data-reveal>
        <p class="flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.16em] text-[#ffaa00]">
          <span class="relative flex h-2 w-2">
            <span
              class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[#ffaa00] opacity-75"
              data-nav-badge-ring
            ></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-[#ffaa00]"></span>
          </span>
          {eyebrow}
        </p>

        <h2 class="mt-3 text-3xl font-bold text-[#003366] md:text-4xl">{title}</h2>
        <p class="mt-3 text-lg font-medium text-[#003366]/85">{subtitle}</p>
        <p class="mt-4 text-[#003366]/80">{text}</p>

        <a
          href={formHref}
          target="_blank"
          rel="noreferrer"
          class="mt-8 inline-flex items-center gap-2 rounded-full bg-[#003366] px-7 py-3.5 text-base font-semibold text-white shadow-lg transition hover:-translate-y-0.5 hover:bg-[#002244] hover:shadow-xl"
        >
          {buttonLabel}
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2.2"
              d="M17 8l4 4m0 0l-4 4m4-4H3"
            ></path>
          </svg>
        </a>
      </div>

      <div class="grid gap-5" data-reveal>
        {
          steps.map((step, index) => (
            <article class="flex gap-5 rounded-2xl bg-[#f5f7fa] p-6 ring-1 ring-[#003366]/10">
              <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-[#003366] text-lg font-black text-[#ffaa00]">
                {index + 1}
              </span>
              <div>
                <h3 class="text-lg font-bold text-[#003366]">{step.title}</h3>
                <p class="mt-1.5 text-sm leading-relaxed text-[#003366]/80">{step.text}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>
