---
import SectionHeading from "./SectionHeading.astro";

interface Reason {
  title: string;
  text: string;
  icon: "layer" | "clock" | "leaf";
}

interface Props {
  reasons: Reason[];
}

const { reasons } = Astro.props;

const iconPathMap: Record<string, string> = {
  layer: "M4 7l8-4 8 4-8 4-8-4zm0 5l8 4 8-4M4 12v5l8 4 8-4v-5",
  clock: "M12 8v5l3 3m6-4a9 9 0 11-18 0 9 9 0 0118 0z",
  leaf: "M5 13c0-6 4-9 9-9 2 0 4 .5 6 1-1 6-5 11-11 11-2 0-3.5-.4-5-1 2-.4 4-1.2 6-2.5",
};
---

<section class="bg-white py-20">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <SectionHeading
      title="¿Por qué elegir Higiene Industrial Plus EIRP?"
      align="center"
    />

    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {
        reasons.map((reason) => (
          <article
            data-reveal
            class="group rounded-2xl border-t-4 border-accent bg-primary p-7 text-slate-100 shadow-md ring-1 ring-primary/40 transition duration-300 hover:-translate-y-1 hover:shadow-xl"
          >
            <span class="flex h-14 w-14 items-center justify-center rounded-2xl bg-accent/15 text-accent transition group-hover:bg-accent group-hover:text-primary">
              <svg
                class="h-8 w-8"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.8"
                  d={iconPathMap[reason.icon]}
                />
              </svg>
            </span>
            <h3 class="mt-6 text-xl font-bold">{reason.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-slate-100/95">
              {reason.text}
            </p>
          </article>
        ))
      }
    </div>
  </div>
</section>
