---
import SectionHeading from "./SectionHeading.astro";

interface Service {
  id: string;
  title: string;
  subtitle?: string;
  intro: string;
  details: string[];
  highlight?: string;
}

interface Props {
  title: string;
  subtitle: string;
  items: Service[];
}

const { title, subtitle, items } = Astro.props;
---

<section id="servicios" class="bg-surface py-20">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <SectionHeading eyebrow="Servicios" title={title} lead={subtitle} />

    <div class="mt-10 space-y-4 md:hidden">
      {
        items.map((service, index) => (
          <details
            class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-primary/15"
            data-reveal
          >
            <summary class="cursor-pointer text-lg font-semibold text-primary">
              {index + 1}. {service.title}
            </summary>
            {service.subtitle && (
              <p class="mt-4 font-medium text-primary">{service.subtitle}</p>
            )}
            <p class="mt-3 text-primary/80">{service.intro}</p>
            <ul class="mt-4 list-disc space-y-2 pl-5 text-primary/80">
              {service.details.map((detail) => (
                <li>{detail}</li>
              ))}
            </ul>
            {service.highlight && (
              <p class="mt-4 rounded-xl bg-support/45 p-3 font-semibold text-primary">
                {service.highlight}
              </p>
            )}
          </details>
        ))
      }
    </div>

    <div class="mt-12 hidden gap-6 md:grid md:grid-cols-3">
      {
        items.map((service) => (
          <article
            data-reveal
            class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-primary/15 transition hover:-translate-y-1 hover:shadow-lg"
          >
            <h3 class="text-2xl font-bold text-primary">{service.title}</h3>
            {service.subtitle && (
              <p class="mt-2 font-semibold text-primary">{service.subtitle}</p>
            )}
            <p class="mt-3 text-primary/80">{service.intro}</p>
            <ul class="mt-4 space-y-2 text-sm text-primary/80">
              {service.details.map((detail) => (
                <li class="flex gap-2">
                  <span class="mt-1 h-2 w-2 rounded-full bg-accent" />
                  <span>{detail}</span>
                </li>
              ))}
            </ul>
            {service.highlight && (
              <p class="mt-4 rounded-xl bg-primary p-3 font-semibold text-white">
                {service.highlight}
              </p>
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>
