---
import SectionHeading from "./SectionHeading.astro";

interface Service {
  id: string;
  title: string;
  subtitle?: string;
  intro: string;
  details: string[];
  highlight?: string;
}

interface Props {
  title: string;
  subtitle: string;
  items: Service[];
}

const { title, subtitle, items } = Astro.props;
---

<section id="servicios" class="bg-surface py-20">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <SectionHeading eyebrow="Servicios" title={title} lead={subtitle} />

    <div class="mt-10 grid gap-4 md:mt-12 md:grid-cols-3 md:gap-6">
      {
        items.map((service, index) => (
          <details
            class="service-card rounded-2xl bg-white p-5 shadow-sm ring-1 ring-primary/15 transition md:p-6 md:hover:-translate-y-1 md:hover:shadow-lg"
            data-service-card
            data-reveal
          >
            <summary class="service-summary cursor-pointer text-lg font-semibold text-primary md:cursor-default md:text-2xl md:font-bold">
              <span class="md:hidden">{index + 1}. </span>
              {service.title}
            </summary>
            <div class="service-content">
              {service.subtitle && (
                <p class="mt-4 font-medium text-primary md:mt-2 md:font-semibold">
                  {service.subtitle}
                </p>
              )}
              <p class="mt-3 text-primary/80">{service.intro}</p>
              <ul class="mt-4 space-y-2 text-primary/80 md:text-sm">
                {service.details.map((detail) => (
                  <li class="flex gap-2">
                    <span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-accent md:mt-1" />
                    <span>{detail}</span>
                  </li>
                ))}
              </ul>
              {service.highlight && (
                <p class="mt-4 rounded-xl bg-support/45 p-3 font-semibold text-primary md:bg-primary md:text-white">
                  {service.highlight}
                </p>
              )}
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  @media (min-width: 48rem) {
    .service-summary {
      list-style: none;
      pointer-events: none;
    }

    .service-summary::-webkit-details-marker {
      display: none;
    }
  }
</style>

<script>
  const desktopServices = window.matchMedia("(min-width: 768px)");
  const serviceCards = document.querySelectorAll<HTMLDetailsElement>(
    "[data-service-card]",
  );

  const syncServiceCards = (isDesktop: boolean) => {
    serviceCards.forEach((card) => {
      if (isDesktop) card.open = true;
      else card.removeAttribute("open");
    });
  };

  serviceCards.forEach((card) => {
    card.addEventListener("toggle", () => {
      if (desktopServices.matches && !card.open) card.open = true;
    });
  });

  desktopServices.addEventListener("change", (event) =>
    syncServiceCards(event.matches),
  );
  syncServiceCards(desktopServices.matches);
</script>
