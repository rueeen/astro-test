---
import { Picture } from "astro:assets";
import backgroundPic from "../assets/banner2.png";

interface Props {
  heading: string;
  subheading: string;
  supportingText: string;
  chips: string[];
  whatsappHref: string;
}

const { heading, subheading, supportingText, chips, whatsappHref } =
  Astro.props;
---

<section
  id="inicio"
  class="relative min-h-screen overflow-hidden bg-primary text-white"
>
  <!-- Imagen de fondo -->
  <div class="absolute inset-0">
    <Picture
      src={backgroundPic}
      formats={["avif", "webp"]}
      widths={[640, 960, 1280, 1920, 2560]}
      sizes="100vw"
      alt="Fondo industrial de Higiene Industrial Plus EIRP"
      class="absolute inset-0 h-full w-full max-w-none scale-[1.05] object-cover object-center md:object-[70%_center]"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      data-parallax
    />
  </div>

  <!-- Capa oscura -->
  <div
    class="absolute inset-0 bg-gradient-to-b from-primary/90 via-primary/80 to-primary/70 md:bg-gradient-to-r"
    aria-hidden="true"
  >
  </div>

  <!-- Contenido -->
  <div
    class="relative mx-auto flex min-h-screen max-w-7xl flex-col justify-center px-5 pb-10 pt-32 lg:px-8"
  >
    <p
      class="mb-3 text-sm font-semibold uppercase tracking-[0.18em] text-accent"
      data-hero-in
      style="--hero-delay: 60ms"
    >
      Operación industrial continua
    </p>

    <h1
      class="max-w-3xl text-4xl font-black leading-tight sm:text-5xl md:text-7xl"
      data-hero-in
      style="--hero-delay: 160ms"
    >
      {heading}
    </h1>

    <h2
      class="mt-3 max-w-3xl text-2xl font-semibold text-slate-100 md:text-4xl"
      data-hero-in
      style="--hero-delay: 260ms"
    >
      {subheading}
    </h2>

    <p
      class="mt-6 max-w-2xl text-base text-slate-100/90 sm:text-lg"
      data-hero-in
      style="--hero-delay: 360ms"
    >
      {supportingText}
    </p>

    <div
      class="mt-8 flex flex-wrap gap-3"
      data-hero-in
      style="--hero-delay: 440ms"
    >
      {
        chips.map((chip) => (
          <span class="rounded-full border border-white/35 bg-white/10 px-4 py-2 text-sm font-medium backdrop-blur-sm">
            {chip}
          </span>
        ))
      }
    </div>

    <div
      class="mt-10 flex flex-wrap gap-4"
      data-hero-in
      style="--hero-delay: 520ms"
    >
      <a
        href="#contacto"
        class="rounded-full bg-accent px-7 py-3.5 text-base font-semibold text-primary transition hover:scale-[1.03] hover:bg-accent-hover focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
      >
        Solicitar cotización
      </a>

      <a
        href={whatsappHref}
        target="_blank"
        rel="noreferrer"
        class="rounded-full border border-white/40 px-7 py-3.5 text-base font-semibold text-white transition hover:scale-[1.03] hover:bg-white/15 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
      >
        Hablar por WhatsApp
      </a>
    </div>
  </div>
</section>

<style>
  picture {
    display: contents;
  }
</style>

<script>
  // Subtle scroll parallax on the hero background image.
  // Throttled with rAF, disabled entirely for reduced-motion users via CSS.
  const parallaxEl = document.querySelector<HTMLElement>("[data-parallax]");
  const heroSection = document.querySelector<HTMLElement>("#inicio");
  const prefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  if (parallaxEl && heroSection && !prefersReducedMotion) {
    let ticking = false;

    const updateParallax = () => {
      const rect = heroSection.getBoundingClientRect();
      // Only animate while the hero is at least partially in view.
      if (rect.bottom > 0 && rect.top < window.innerHeight) {
        const offset = Math.min(Math.max(0, -rect.top) * 0.08, 20);
        parallaxEl.style.transform = `translateY(${offset}px)`;
      }
      ticking = false;
    };

    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          requestAnimationFrame(updateParallax);
          ticking = true;
        }
      },
      { passive: true },
    );

    updateParallax();
  }
</script>
