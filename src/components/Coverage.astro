---
import { Image } from "astro:assets";
import mapaCobertura from "../assets/mapa-cobertura-2.png";
import SectionHeading from "./SectionHeading.astro";

interface City {
  name: string;
  top: string;
  left: string;
  status: "operativo" | "expansion";
}

interface Props {
  title: string;
  text: string;
  points: string[];
  cities: City[];
}

const { title, text, points, cities } = Astro.props;
const cityLabel = (city: City) =>
  city.status === "expansion" ? `${city.name} · Próximamente` : city.name;
---

<section
  id="cobertura"
  class="coverage-section relative overflow-hidden bg-primary py-20 text-slate-100"
>
  <div class="coverage-glow pointer-events-none absolute inset-0"></div>

  <div class="relative mx-auto max-w-7xl px-5 lg:px-8">
    <div
      class="grid items-center gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:gap-16"
    >
      <div
        class="map-card relative overflow-hidden rounded-[32px] bg-primary/60 p-4 sm:p-6"
        data-reveal
      >
        <div class="relative mx-auto aspect-[1248/3444] w-[170px] sm:w-[209px]">
          <div class="absolute inset-0">
            <Image
              src={mapaCobertura}
              alt="Mapa de cobertura de Chile"
              class="absolute inset-0 h-full w-full opacity-95 saturate-[1.15]"
            />
          </div>

          <div class="absolute inset-0">
            {
              cities.map((city, index) => (
                <div
                  class="absolute z-10"
                  style={`top: ${city.top}; left: ${city.left}; transform: translate(-50%, -50%);`}
                >
                  <button
                    type="button"
                    class="group relative block rounded-full focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-support"
                    aria-label={
                      city.status === "expansion"
                        ? `Proyección de cobertura en ${city.name}`
                        : `Cobertura en ${city.name}`
                    }
                    data-pin
                    style={`--pin-delay: ${300 + index * 140}ms;`}
                  >
                    {city.status === "operativo" && (
                      <span class="absolute left-1/2 top-1/2 h-5 w-5 -translate-x-1/2 -translate-y-1/2 animate-ping rounded-full bg-support/30 sm:h-6 sm:w-6" />
                    )}

                    <span
                      class:list={[
                        "pin-dot relative block h-3.5 w-3.5 rounded-full border-2 sm:h-4 sm:w-4",
                        city.status === "operativo"
                          ? "border-primary bg-support"
                          : "border-dashed border-primary bg-transparent",
                      ]}
                    />

                    <span class="pointer-events-none absolute left-5 top-1/2 hidden -translate-y-1/2 whitespace-nowrap rounded-md bg-primary/95 px-2 py-1 text-[10px] font-bold text-white opacity-0 shadow-xl backdrop-blur-sm transition-all duration-300 ease-out group-hover:translate-x-1 group-hover:bg-support group-hover:text-primary group-hover:opacity-100 group-focus-visible:translate-x-1 group-focus-visible:bg-support group-focus-visible:text-primary group-focus-visible:opacity-100 md:block sm:left-6 sm:px-2.5 sm:text-[11px]">
                      {cityLabel(city)}
                    </span>
                  </button>
                </div>
              ))
            }
          </div>
        </div>

        <ul
          class="mt-4 grid grid-cols-2 gap-2 border-t border-white/15 pt-4 text-xs sm:text-sm md:hidden"
          aria-label="Ciudades de cobertura"
        >
          {
            cities.map((city) => (
              <li class="flex items-center gap-2 text-slate-100">
                <span
                  class:list={[
                    "h-2.5 w-2.5 shrink-0 rounded-full border border-support",
                    city.status === "operativo"
                      ? "bg-support"
                      : "border-dashed bg-transparent",
                  ]}
                />
                {cityLabel(city)}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="space-y-8">
        <SectionHeading title={title} lead={text} light />

        <div data-reveal>
          <ul class="space-y-4">
            {
              points.map((point) => (
                <li class="coverage-point flex items-start gap-3 rounded-2xl border border-white/15 bg-white/[0.07] p-4 backdrop-blur-sm transition-all hover:border-white/30 sm:items-center sm:gap-4 sm:p-5">
                  <span class="point-dot h-3.5 w-3.5 shrink-0 rounded-full bg-support" />
                  <span class="text-base font-semibold leading-snug text-slate-200 sm:text-xl">
                    {point}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .coverage-glow {
    background: radial-gradient(
      circle at top,
      color-mix(in srgb, var(--color-support-glow) 28%, transparent),
      transparent 56%
    );
  }

  .map-card {
    box-shadow: 0 30px 60px
      color-mix(in srgb, var(--color-primary-deep) 70%, transparent);
  }

  .pin-dot {
    box-shadow: 0 0 6px
      color-mix(in srgb, var(--color-support-glow) 90%, transparent);
  }

  .coverage-point {
    box-shadow: 0 10px 35px
      color-mix(in srgb, var(--color-primary-deep) 70%, transparent);
  }

  .point-dot {
    box-shadow: 0 0 16px
      color-mix(in srgb, var(--color-support-glow) 95%, transparent);
  }
</style>
